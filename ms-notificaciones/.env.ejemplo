# Configuracion del microservicio Notificaciones.
# Copiar a .env y ajustar. Ninguna de estas variables despliega infraestructura:
# el cluster de Pulsar es externo y lo despliega el equipo en otro punto.

# --- Proceso ------------------------------------------------------------------
# Puerto HTTP donde escucha el servicio. Default 8000 (igual que antes).
PORT=8000

# Identificador de esta replica (para logs y, mas adelante, para el header
# X-Instance-Id). Si se deja vacio, se usa el hostname del proceso/contenedor.
INSTANCE_ID=

# --- Persistencia propia (topologia descentralizada) -------------------------
# Por defecto usa SQLite local (./ms-notificaciones.db). Para Postgres:
# DATABASE_URL=postgresql://ms-notificaciones:ms-notificaciones@localhost:5432/ms-notificaciones
DATABASE_URL=sqlite:///./notificaciones.db
ECHO_SQL=false

# --- Cluster de Pulsar (lo despliega el equipo, no este servicio) -----------
# Dejar VACIO mientras el cluster no exista: el servicio arranca igual, solo
# sin consumir comandos (sirve las queries HTTP igual).
PULSAR_SERVICE_URL=
PULSAR_TENANT=hogar
PULSAR_NAMESPACE=alpes

# Debe ser IDENTICA en todas las replicas: es lo que las hace consumidores en
# competencia sobre la misma suscripcion compartida.
PULSAR_SUSCRIPCION=notificaciones-workers

# Opcionales: solo si se necesita apuntar a un topico distinto al del contrato
# real (por ejemplo, en el experimento de disponibilidad, para no interferir
# con el topico que usa el despliegue compartido). Vacio = se usa el nombre
# calculado a partir de PULSAR_TENANT/PULSAR_NAMESPACE (comportamiento actual).
TOPICO_COMANDOS=
TOPICO_EVENTOS=
