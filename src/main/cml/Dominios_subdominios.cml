Domain GestionServiciosParaElHogar {
    domainVisionStatement = "Conectar de forma segura, confiable y eficiente las necesidades de los hogares con proveedores de servicios verificados, gestionando integralmente el ciclo de vida de los trabajos desde su creación hasta su ejecución, cierre y evaluación."

Subdomain GestionTrabajos {
    type = CORE_DOMAIN
    domainVisionStatement = "Asignación de trabajos a un tipo de cliente hogar."
}

Subdomain GestionProveedores {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión de Proveedores, encargado del ciclo de vida del profesional o empresa."
}

Subdomain VerificacionAcreditacion {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión de la verificación y acreditación de proveedores, incluyendo la validación de identidad, antecedentes, certificaciones y cumplimiento de normativas."
}

Subdomain Marketplace {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión del servicio orientado al dueño de hogar. Incluye el registro de usuarios y asignación de trabajos a proveedores."
}

Subdomain CotizacionContratacion {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión del proceso de cotización y contratación de servicios, tanto para usuarios del marketplace como para flujos de partners."
}

Subdomain GestionPartnersB2B2C {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión de partners de tipo B2B2C, incluyendo la integración de sus flujos de trabajo e interoperabilidad con sus sistemas."
}

Subdomain GestionSiniestrosB2B2C {
    type = CORE_DOMAIN
    domainVisionStatement = "Gestión de todo el flujo de trabajo asociado a siniestros y polizas, incluyendo el manejo de evidencias y auditoria."
}

Subdomain GestionServicio {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Gestión del flujo de trabajo para un servicio, incluyendo monitoreo, avance, novedades, disputas y cambios de un servicio."
}

Subdomain FacturacionPartners {
    type = SUPPORTING_DOMAIN
    domainVisionStatement = "Manejo de la facturación y cobro a partners, según acuerdo comercial."
}

Subdomain Notificaciones {
    type = GENERIC_SUBDOMAIN
    domainVisionStatement = "Gestión de todo tipo de notificaciones a proveedores, clientes y partners."
}

Subdomain IdentidadAutenticacion {
    type = GENERIC_SUBDOMAIN
    domainVisionStatement = "Gestión de manejo de usuarios, así como métodos de autenticación en la plataforma."
}

Subdomain ProcesamientoPagos {
    type = GENERIC_SUBDOMAIN
    domainVisionStatement = "Gestión de pagos de flujos de trabajo de hogar a través de pasarelas de pago."
}
}

Domain ServiciosFinancieros {
    domainVisionStatement = "Proporcionar servicios financieros a los proveedores de Hogar de los Alpes, aprovechando su historial de trabajo y comportamiento en la plataforma para facilitar la gestión de sus recursos, mejorar su acceso a financiación y contribuir al crecimiento de sus negocios."
    
    Subdomain Wallet {
        type = CORE_DOMAIN
        domainVisionStatement = "Gestiona los servicios asociados a la wallet de proveedores, así como el acceso a prestamos y microprestamos."
    }

    Subdomain ScoringFinanciero {
        type = CORE_DOMAIN
        domainVisionStatement = "Manejo del scoring financiero de los proveedores a partir de su historial de trabajos."
    }

    Subdomain GestionPagos {
        type = GENERIC_SUBDOMAIN
        domainVisionStatement = ""
    }
}


BoundedContext GestionTrabajos implements GestionTrabajos  {

}

BoundedContext DiagnosticoAdmision implements CotizacionContratacion {

}

BoundedContext MarketplaceAsignacion implements Marketplace, CotizacionContratacion {

}

BoundedContext Proveedores implements GestionProveedores {

}

BoundedContext AcreditacionCumplimiento implements VerificacionAcreditacion {

}

BoundedContext GeneradorCotizaciones implements CotizacionContratacion {

}

BoundedContext OrquestacionWorkflows implements GestionTrabajos, GestionServicio {

}

BoundedContext EjecucionEvidenciasSeguimiento implements GestionTrabajos, GestionServicio {

}

BoundedContext SiniestrosOperacionB2B2C implements GestionSiniestrosB2B2C, GestionServicio {

}

BoundedContext PagosLiquidaciones implements FacturacionPartners, ProcesamientoPagos, GestionPagos {

}

BoundedContext CalidadGarantiasDisputas implements GestionServicio {

}

BoundedContext FintechWalletCredito implements GestionPagos, Wallet, ScoringFinanciero {

}

BoundedContext AlianzasIntegracionesB2B2C implements GestionPartnersB2B2C {

}

ContextMap HogarDeLosAlpes {
	state = AS_IS

    contains GestionTrabajos
    contains DiagnosticoAdmision
    contains MarketplaceAsignacion
    contains Proveedores
    contains AcreditacionCumplimiento
    contains GeneradorCotizaciones
    contains OrquestacionWorkflows
    contains EjecucionEvidenciasSeguimiento
    contains SiniestrosOperacionB2B2C
    contains PagosLiquidaciones
    contains CalidadGarantiasDisputas
    contains FintechWalletCredito
    contains AlianzasIntegracionesB2B2C
	
    GestionTrabajos [P] <-> [P] DiagnosticoAdmision
    AlianzasIntegracionesB2B2C [P] <-> [P] SiniestrosOperacionB2B2C
	SiniestrosOperacionB2B2C [SK]<->[SK] GestionTrabajos
    GestionTrabajos [P] <-> [P] OrquestacionWorkflows
    MarketplaceAsignacion [P] <-> [P] OrquestacionWorkflows
    MarketplaceAsignacion [SK]<->[SK] Proveedores
    Proveedores [SK]<->[SK] AcreditacionCumplimiento
    MarketplaceAsignacion [P] <-> [P] AcreditacionCumplimiento
    MarketplaceAsignacion [P] <-> [P] GeneradorCotizaciones
    GeneradorCotizaciones [P] <-> [P] GestionTrabajos
    OrquestacionWorkflows [SK]<->[SK] EjecucionEvidenciasSeguimiento
    GestionTrabajos [SK]<->[SK] EjecucionEvidenciasSeguimiento
    EjecucionEvidenciasSeguimiento [P] <-> [P] CalidadGarantiasDisputas
    MarketplaceAsignacion [P] <-> [P] CalidadGarantiasDisputas
    GestionTrabajos [P] <-> [P] PagosLiquidaciones
    SiniestrosOperacionB2B2C [P] <-> [P] PagosLiquidaciones
    FintechWalletCredito [P] <-> [P] PagosLiquidaciones
    Proveedores [P] <-> [P] FintechWalletCredito
    SiniestrosOperacionB2B2C [SK]<->[SK] AlianzasIntegracionesB2B2C
}
